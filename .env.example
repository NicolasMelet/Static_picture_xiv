# Copiez ce fichier en .env et remplissez les valeurs.
# .env est ignoré par git : il ne sera jamais poussé sur GitHub.

# https://www.fflogs.com/api/clients/  (URL de redirection : http://localhost)
FFLOGS_CLIENT_ID=COLLER_ICI
FFLOGS_CLIENT_SECRET=COLLER_ICI

# Jeton GitHub "fine-grained", limité au dépôt, permission Contents : Read and write
GITHUB_TOKEN=COLLER_ICI
