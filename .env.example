# Copy this file to .env and fill in the values.
# .env is ignored by git: it is never pushed to GitHub.

# https://www.fflogs.com/api/clients/  (redirect URL: http://localhost)
FFLOGS_CLIENT_ID=PASTE_HERE
FFLOGS_CLIENT_SECRET=PASTE_HERE

# GitHub fine-grained token, limited to the repository, permission Contents: Read and write
GITHUB_TOKEN=PASTE_HERE
